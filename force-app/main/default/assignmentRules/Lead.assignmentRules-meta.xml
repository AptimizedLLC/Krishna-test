<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>Assign to Creating User</fullName>
        <active>false</active>
    </assignmentRule>
    <assignmentRule>
        <fullName>Website and CallRail</fullName>
        <active>true</active>
        <ruleEntry>
            <assignedTo>New_Web_Leads</assignedTo>
            <assignedToType>Queue</assignedToType>
            <booleanFilter>1 OR 2 OR 3</booleanFilter>
            <criteriaItems>
                <field>Lead.LeadSource</field>
                <operation>equals</operation>
                <value>Website</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.LeadSource</field>
                <operation>equals</operation>
                <value>NJSW Website</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.LeadSource</field>
                <operation>equals</operation>
                <value>AO Website</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>CallRail</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.LeadSource</field>
                <operation>equals</operation>
                <value>CallRail</value>
            </criteriaItems>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
