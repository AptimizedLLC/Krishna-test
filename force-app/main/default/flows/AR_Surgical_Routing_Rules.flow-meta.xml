            {!$Record.AR_Provider_Id__c} = &quot;32700&quot;,
            {!$Record.AR_Provider_Id__c} = &quot;35974&quot;,
            {!$Record.AR_Provider_Id__c} = &quot;38624&quot;,
            {!$Record.AR_Provider_Id__c} = &quot;38179&quot;,
            {!$Record.AR_Provider_Id__c} = &quot;39028&quot;,
            {!$Record.AR_Provider_Id__c} = &quot;38625&quot;,
            {!$Record.AR_Provider_Id__c} = &quot;39999&quot;,
            {!$Record.AR_Provider_Id__c} = &quot;40039&quot;
        )
    ),
    &quot;Valid&quot;,
    &quot;Invalid&quot;
)</expression>
    </formulas>
