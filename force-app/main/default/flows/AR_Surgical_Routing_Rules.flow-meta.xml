    &quot;Invalid&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Logic_for_FC_in_AI_or_WC</name>
        <dataType>String</dataType>
        <expression>IF(
    OR(
        {!$Record.AR_Financial_Class__c} = &quot;Auto Insurance&quot;,
        {!$Record.AR_Financial_Class__c} = &quot;Workers Compensation&quot;
    ),
    &quot;Valid&quot;,
    &quot;Invalid&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Logic_for_FC_in_Cash_Pay</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        {!$Record.AR_Financial_Class__c} = &quot;Cash Pay&quot;,
        OR(
            TEXT({!$Record.Injection_Status__c}) = &quot;BTA&quot;,
            TEXT({!$Record.Injection_Status__c}) = &quot;LOP&quot;
        )
    ),
    &quot;Valid&quot;,
    &quot;Invalid&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Logic_for_FC_not_in_AI_or_WC</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        NOT(
            OR(
                {!$Record.AR_Financial_Class__c} = &quot;Auto Insurance&quot;,
                {!$Record.AR_Financial_Class__c} = &quot;Workers Compensation&quot;
            )
        ),
        OR(
            {!$Record.AR_Provider_Id__c} = &quot;34760&quot;,
            {!$Record.AR_Provider_Id__c} = &quot;35225&quot;,
            {!$Record.AR_Provider_Id__c} = &quot;35730&quot;,
            {!$Record.AR_Provider_Id__c} = &quot;35392&quot;,
            {!$Record.AR_Provider_Id__c} = &quot;37433&quot;,
