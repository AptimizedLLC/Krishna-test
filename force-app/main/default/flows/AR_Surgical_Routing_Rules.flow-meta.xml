    <formulas>
        <name>AI_or_WC_A_to_I</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        NOT(ISBLANK({!$Record.AR_Patient_Account__c.AR_Name__c})),
        UPPER(TRIM({!$Record.AR_Patient_Account__c.AR_Name__c})) &gt;= &quot;A&quot;,
        UPPER(TRIM({!$Record.AR_Patient_Account__c.AR_Name__c})) &lt; &quot;J&quot;
    ),
    &quot;Valid&quot;,
    &quot;Invalid&quot;
)</expression>
    </formulas>
    <formulas>
        <name>AI_or_WC_J_to_P</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        NOT(ISBLANK({!$Record.AR_Patient_Account__c.AR_Name__c})),
        UPPER(TRIM({!$Record.AR_Patient_Account__c.AR_Name__c})) &gt;= &quot;J&quot;,
        UPPER(TRIM({!$Record.AR_Patient_Account__c.AR_Name__c})) &lt; &quot;Q&quot;
    ),
    &quot;Valid&quot;,
    &quot;Invalid&quot;
)</expression>
    </formulas>
    <formulas>
        <name>AI_or_WC_Q_to_Z</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        NOT(ISBLANK({!$Record.AR_Patient_Account__c.AR_Name__c})),
        UPPER(TRIM({!$Record.AR_Patient_Account__c.AR_Name__c})) &gt;= &quot;Q&quot;
