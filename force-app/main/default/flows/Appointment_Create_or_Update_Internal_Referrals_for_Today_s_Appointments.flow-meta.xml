    <decisions>
        <name>Visit_Reason_Includes_PIP_Or_WC</name>
        <label>Visit Reason Includes PIP Or WC?</label>
        <locationX>182</locationX>
        <locationY>360</locationY>
        <defaultConnector>
            <targetReference>Get_Patient_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Visit Reason Does Not Include PIP Or WC</defaultConnectorLabel>
        <rules>
            <name>Yes_Visit_Reason_Includes_PIP_Or_WC</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Visit_Reason__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>PIP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Visit_Reason__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>WC</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Visit_Reason__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>W/C</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Reimbursement_Variable</targetReference>
            </connector>
            <label>Yes - Visit Reason Includes PIP Or WC</label>
        </rules>
    </decisions>
