    <decisions>
        <name>Check_for_Prior_Treatment</name>
        <label>Check for Prior Treatment</label>
        <locationX>479</locationX>
        <locationY>1284</locationY>
        <defaultConnector>
            <targetReference>Check_for_Qualifying_Condition</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No - There is No Prior Treatment</defaultConnectorLabel>
        <rules>
            <name>Yes_There_is_Prior_Treatment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varLatestIntake.Have_you_had_previous_treatment_NEW__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <label>Yes - There is Prior Treatment</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_Qualifying_Condition</name>
        <label>Check for Qualifying Condition</label>
        <locationX>809</locationX>
        <locationY>1392</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Chang_Qualifying_Condition</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Latest_Intake.Headache_Migraine__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Latest_Intake.Wrist_Hand_Pain__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Latest_Intake.Neck_Pain__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Latest_Intake.Mid_Back_Pain__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Latest_Intake.Scoliosis__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Latest_Intake.Lower_Back_Pain_Sciatica__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Latest_Intake.Lower_Back_Pain_Axial__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Latest_Intake.Neurological_Condition__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Chang_Name_Variable</targetReference>
            </connector>
            <label>Chang Qualifying Condition</label>
        </rules>
        <rules>
            <name>Rajaram_Qualifying_Condition</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Latest_Intake.Shoulder_Pain__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Latest_Intake.Knee_Pain__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Rajaram_Name_Variable</targetReference>
            </connector>
            <label>Rajaram Qualifying Condition</label>
        </rules>
        <rules>
            <name>Harrington_Qualifying_Condition</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Latest_Intake.Elbow_Pain__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Harrington_Name_Variable</targetReference>
            </connector>
            <label>Harrington Qualifying Condition</label>
        </rules>
