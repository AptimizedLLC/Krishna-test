    <decisions>
        <name>Check_time</name>
        <label>Check time</label>
        <locationX>314</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Before_4_PM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>createdtime</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>fourtime</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Intake_PDF</targetReference>
            </connector>
            <label>Before 4 PM</label>
        </rules>
        <rules>
            <name>After_4_Pm</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>createdtime</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>fourtime</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Get_Intake_PDF</targetReference>
            </connector>
            <label>After 4 Pm</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Before4PM</name>
        <dataType>Boolean</dataType>
        <expression>DATETIMEVALUE(TEXT(DATEVALUE({!$Record.CreatedDate})) &amp; &quot; 03:00:00&quot;) &lt; {!$Record.CreatedDate}</expression>
    </formulas>
    <formulas>
        <name>createdtime</name>
        <dataType>Time</dataType>
        <expression>TIMEVALUE({!$Record.CreatedDate} - (4 / 24))</expression>
    </formulas>
    <formulas>
        <name>fourtime</name>
        <dataType>Time</dataType>
        <expression>TIMEVALUE(&quot;02:30:45.125&quot;)</expression>
    </formulas>
    <formulas>
        <name>x4PM</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT(TODAY()) &amp; &quot; 02:00:00&quot;)</expression>
    </formulas>
