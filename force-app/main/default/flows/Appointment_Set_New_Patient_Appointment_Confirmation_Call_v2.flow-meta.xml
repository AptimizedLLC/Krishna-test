    <environments>Default</environments>
    <formulas>
        <name>fxDayofWeekNumber</name>
        <dataType>Number</dataType>
        <expression>weekday(today())</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxUnmetDeductible</name>
        <dataType>Currency</dataType>
        <expression>{!Get_Insurance_Plan.Out_of_Network_Individual_Deductible__c} - {!Get_Coverage.Out_of_Network_Deductible_Met__c}</expression>
        <scale>2</scale>
    </formulas>
