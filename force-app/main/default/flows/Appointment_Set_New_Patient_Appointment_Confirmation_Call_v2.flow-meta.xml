    <decisions>
        <name>Front_Desk_or_Contact_Center_to_Make_Follow_Up_Call</name>
        <label>Front Desk or Contact Center to Make Follow Up Call?</label>
        <locationX>446</locationX>
        <locationY>1284</locationY>
        <defaultConnector>
            <targetReference>Copy_1_of_Update_Appointment_for_Contact_Center</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Contact Center</defaultConnectorLabel>
        <rules>
            <name>Front_Desk</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>fxUnmetDeductible</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>1500.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Visit_Reason__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>PIP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Insurance_Plan.Out_of_Network_Individual_Deductible__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Appointment_for_Front_Desk</targetReference>
            </connector>
            <label>Front Desk</label>
        </rules>
    </decisions>
