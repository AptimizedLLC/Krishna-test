<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Day_of_the_Week</name>
        <label>Check Day of the Week</label>
        <locationX>545</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Monday_Through_Thursday</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>fxDayofWeekNumber</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fxDayofWeekNumber</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fxDayofWeekNumber</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>4.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fxDayofWeekNumber</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Tomorrows_Appointments</targetReference>
            </connector>
            <label>Monday Through Thursday</label>
        </rules>
        <rules>
            <name>Friday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxDayofWeekNumber</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>6.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Mondays_Appointments</targetReference>
            </connector>
            <label>Friday</label>
        </rules>
    </decisions>
    <decisions>
        <description>This checks the record that is being interviewed if it has an appointment for Monday</description>
        <name>Check_Mondays_Appointments</name>
        <label>Check Mondays Appointments</label>
        <locationX>589</locationX>
        <locationY>360</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Mondays_Appointment</name>
            <conditionLogic>1 AND 2 AND 3 AND 4 AND NOT(5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Days_Until_Appointment__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Visit_Reason__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>NEW</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Day_of_the_Week__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Visit_Reason__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>ESTABLISHED</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Most_Recent_Major_Med_VOB</targetReference>
            </connector>
            <label>Mondays Appointment</label>
        </rules>
    </decisions>
