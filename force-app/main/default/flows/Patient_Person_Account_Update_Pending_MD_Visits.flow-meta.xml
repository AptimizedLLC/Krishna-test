            <value>
                <stringValue>Manually Billed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Visit_Reason__c</field>
            <operator>StartsWith</operator>
            <value>
                <stringValue>MD</stringValue>
            </value>
        </filters>
        <filters>
            <field>Patient__c</field>
            <operator>EqualTo</operator>
            <value>
