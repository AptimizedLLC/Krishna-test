<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Reimbursement_Type_Allowance</name>
        <label>Assign Reimbursement Type &amp; Allowance %</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>varReimbursementType</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>MCR</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAllowancePercentage</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <targetReference>Update_Appointment_Record_with_Reimbursement_Type</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Is_Reimbursement_Type_Available</name>
        <label>Is Reimbursement Type Available?</label>
        <locationX>402</locationX>
        <locationY>566</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Reimbursement_Type_is_Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varReimbursementType</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Appointment_Record_with_Reimbursement_Type</targetReference>
            </connector>
            <label>Yes - Reimbursement Type is Available</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_There_a_Case_Id</name>
        <label>Is There a Case Id?</label>
        <locationX>490</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_There_is_a_Case_Id</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varVOBCaseId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_VOB_Type_Medicare</targetReference>
            </connector>
            <label>Yes - There is a Case Id</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_VOB_Type_Medicare</name>
        <label>Is VOB Type Medicare?</label>
        <locationX>226</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Get_Insurance_Plan_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_VOB_Type_Is_Medicare</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varVOBType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Medicare</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Reimbursement_Type_Allowance</targetReference>
            </connector>
            <label>Yes - VOB Type Is Medicare</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Test 2 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Test 2</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Insurance_Plan_Records</name>
        <label>Get Insurance Plan Records</label>
        <locationX>402</locationX>
        <locationY>458</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Reimbursement_Type_Available</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>VOB_Case__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varVOBCaseId</elementReference>
            </value>
        </filters>
        <object>Insurance_Plan__c</object>
        <outputAssignments>
            <assignToReference>varAllowancePercentage</assignToReference>
            <field>Allowance_Percentage__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varReimbursementType</assignToReference>
            <field>Reimbursement_Type__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varVOBType</assignToReference>
            <field>VOB_Type__c</field>
        </outputAssignments>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <recordLookups>
        <name>Get_VOB_Case</name>
        <label>Get VOB Case</label>
        <locationX>490</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_There_a_Case_Id</targetReference>
        </connector>
        <filterLogic>(1 OR 2 OR 3) AND 4 AND 5 AND NOT(6)</filterLogic>
        <filters>
            <field>VOB_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Medicare</stringValue>
            </value>
        </filters>
        <filters>
            <field>VOB_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Major Med</stringValue>
            </value>
        </filters>
        <filters>
            <field>VOB_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Reverification</stringValue>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId.Patient__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Date_Value_of_Created_Date__c</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>recordId.Appointment_Date__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Secondary</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <outputAssignments>
            <assignToReference>varVOBCaseId</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varVOBType</assignToReference>
            <field>VOB_Type__c</field>
        </outputAssignments>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <recordUpdates>
        <name>Update_Appointment_Record_with_Reimbursement_Type</name>
        <label>Update Appointment Record with Reimbursement Type</label>
        <locationX>226</locationX>
        <locationY>950</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Reimbursement_Type__c</field>
            <value>
                <elementReference>varReimbursementType</elementReference>
            </value>
        </inputAssignments>
        <object>Appointment__c</object>
    </recordUpdates>
    <start>
        <locationX>364</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_VOB_Case</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>recordId</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Appointment__c</objectType>
    </variables>
    <variables>
        <name>varAllowancePercentage</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>varReimbursementType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varVOBCaseId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varVOBType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
