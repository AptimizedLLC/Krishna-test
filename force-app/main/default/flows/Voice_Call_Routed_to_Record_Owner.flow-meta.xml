    <decisions>
        <name>Is_Estimated_Wait_Time_Less_Than_20_Seconds</name>
        <label>Is Estimated Wait Time Less Than 20 Seconds?</label>
        <locationX>495</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>Route_to_Front_Desk</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Estimated_Wait_Time_Is_Less_Than_20_Seconds</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_Availability_of_SCV_Basic_Queue.estimatedWaitTime</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>20.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Route_to_Queue</targetReference>
            </connector>
            <label>Yes - Estimated Wait Time Is Less Than 20 Seconds</label>
        </rules>
    </decisions>
