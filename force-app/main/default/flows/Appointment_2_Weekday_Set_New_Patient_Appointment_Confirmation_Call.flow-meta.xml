    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_It_a_Weekday</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3 AND NOT(4) AND 5</filterLogic>
        <filters>
            <field>Days_Until_Appointment__c</field>
            <operator>EqualTo</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <filters>
            <field>Visit_Reason__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>New</stringValue>
            </value>
        </filters>
        <filters>
            <field>Visit_Reason__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>ESTABLISHED</stringValue>
            </value>
        </filters>
        <filters>
            <field>New_Patient_Confirmation_Call__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Appointment__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2023-10-30</startDate>
            <startTime>15:30:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <subflows>
