<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_It_a_Weekday</name>
        <label>Is It a Weekday?</label>
        <locationX>182</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_It_Is_a_Weekday</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>fxDayofWeekNumber</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fxDayofWeekNumber</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fxDayofWeekNumber</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>4.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fxDayofWeekNumber</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_New_Patient_Confirmation_Call</targetReference>
            </connector>
            <label>Yes - It Is a Weekday</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fxDayofWeekNumber</name>
        <dataType>Number</dataType>
        <expression>weekday(today())</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxToday</name>
        <dataType>Date</dataType>
        <expression>Today()</expression>
    </formulas>
    <formulas>
        <name>fxUnmetDeductible</name>
        <dataType>Currency</dataType>
        <expression>{!varOutOfNetworkDeductible} - {!varOutOfNetworkDeductibleMet}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxUnmetFamilyDeductible</name>
        <dataType>Currency</dataType>
        <expression>{!varOutOfNetworkFamilyDeductible} - {!varOutOfNetworkFamilyDeductibleMet}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Appointment: 2 Weekday Set New Patient Appointment Confirmation Call {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Appointment: 2 Weekday Set New Patient Appointment Confirmation Call</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
