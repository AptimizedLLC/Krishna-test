    <decisions>
        <name>check_if_the_createdby_is_not_call_rail</name>
        <label>check if the createdby is not call rail</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>created_by_call_rail</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getLead.CreatedBy.Email</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>aasfadmin@alliancehealthsystem.com</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_Action_1</targetReference>
            </connector>
            <label>created by call rail</label>
        </rules>
    </decisions>
    <decisions>
        <name>if_owner_team_is_marketing</name>
        <label>if owner team is marketing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>owner_team_is_marketing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getLead.CreatedBy.Team__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Marketing Team</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>appointmentCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_Account</targetReference>
            </connector>
            <label>owner team is marketing</label>
        </rules>
    </decisions>
