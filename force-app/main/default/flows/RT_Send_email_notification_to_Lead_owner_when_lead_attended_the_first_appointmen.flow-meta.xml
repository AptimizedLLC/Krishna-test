        <label>Send Email Action 1</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>getLead.CreatedBy.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <stringValue>CurrentUser</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>composeEmailContent</name>
            <value>
                <stringValue>True</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Patient Checked In – First Appointment Notification</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue>Hello {!getLead.Owner:User.Name},

Good news! Your patient {!$Record.Patient_Name__c},has successfully checked in for their first appointment.

Appointment Details:
Date: {!$Record.Appointment_Date_Time__c}
Location: {!$Record.Location__c}
Provider: {!$Record.Provider_Name__c}

You can now proceed with the intake steps or review the appointment record in Salesforce for more details.

If you have any questions or need assistance, feel free to reach out.

Best regards,
Salesforce Team</stringValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
        <versionString>1.0.1</versionString>
    </actionCalls>
