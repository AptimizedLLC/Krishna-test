<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Decides if the Deductable is Greater than 1500 by Subtracting the Out Of Network Deductable from the Appointment Object (Out_of_Network_Individual_Deductible__c)  from the Out of Network Deductable Met (Out_of_Network_Deductible_Met__c) from the Coverage Object.</description>
        <name>Is_the_Deductable_Greater_than_1500</name>
        <label>Is the Deductable Greater than 1500?</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Greater_than_1500</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>for_DeductableRemaining</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1500.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Appointment</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Appointment</targetReference>
            </connector>
            <label>Greater than 1500</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>This calculates the Deductible Remaining</description>
        <name>for_DeductableRemaining</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Out_of_Network_Individual_Deductible__c} - {!Get_Coverage.Out_of_Network_Deductible_Met__c}</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Insurance Plan: Update Appointment with Intake Confirmation Call {!$Flow.CurrentDateTime}</interviewLabel>
