        <rules>
            <name>Yes_a_PRECERT_Appointment_Already_Scheduled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varVisitReason</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>PRECERT</stringValue>
                </rightValue>
            </conditions>
