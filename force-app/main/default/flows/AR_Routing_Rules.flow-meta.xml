    <formulas>
        <name>Surgical_1_Workbook_logic_364</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        /* CPT begins with 364 */
        NOT(ISBLANK({!$Record.AR_Procedure_Code__c})),
        BEGINS({!$Record.AR_Procedure_Code__c}, &quot;364&quot;),

        /* Location Id not equal to 44699 */
        {!$Record.AR_Location_Id__c} &lt;&gt; &quot;44699&quot;,

        /* Financial class present AND not AI or WC */
        NOT(ISBLANK({!$Record.AR_Financial_Class__c})),
        {!$Record.AR_Financial_Class__c} &lt;&gt; &quot;Auto Insurance&quot;,
        {!$Record.AR_Financial_Class__c} &lt;&gt; &quot;Workers Compensation&quot;
    ),
    &quot;Valid&quot;,
    &quot;Invalid&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Surgical_1_Workbook_logic_6303</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        /* Procedure code exactly is or begins with 6303 */
        NOT(ISBLANK({!$Record.AR_Procedure_Code__c})),
        BEGINS({!$Record.AR_Procedure_Code__c}, &quot;6303&quot;),

        /* Financial class must exist and must not be AI or WC */
        NOT(ISBLANK({!$Record.AR_Financial_Class__c})),
        {!$Record.AR_Financial_Class__c} &lt;&gt; &quot;Auto Insurance&quot;,
        {!$Record.AR_Financial_Class__c} &lt;&gt; &quot;Workers Compensation&quot;
    ),
    &quot;Valid&quot;,
    &quot;Invalid&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Surgical_1_workbook_Pro_Loc</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        /* Financial class must exist and must not be AI or WC */
        NOT(ISBLANK({!$Record.AR_Financial_Class__c})),
        {!$Record.AR_Financial_Class__c} &lt;&gt; &quot;Auto Insurance&quot;,
        {!$Record.AR_Financial_Class__c} &lt;&gt; &quot;Workers Compensation&quot;,

        /* Location Id in list */
        CONTAINS(
            &quot;,&quot; &amp; &quot;44810,48721,48722,51009,51834,51835,44808,44813,48503,48502,48874,44814,44815,50056,50057,44816,44699,44702,53513,53514,55097,55096,53754,55567,56641,56642&quot; &amp; &quot;,&quot;,
            &quot;,&quot; &amp; {!$Record.AR_Location_Id__c} &amp; &quot;,&quot;
        ),

        /* Provider Id in list */
        CONTAINS(
            &quot;,&quot; &amp; &quot;34760,35225,35730,35392,37433,32707,32700,35974,38624,38179,39028,38625,39999&quot; &amp; &quot;,&quot;,
            &quot;,&quot; &amp; {!$Record.AR_Provider_Id__c} &amp; &quot;,&quot;
        )
    ),
    &quot;Valid&quot;,
    &quot;Invalid&quot;
)</expression>
    </formulas>
