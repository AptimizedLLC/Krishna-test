    <formulas>
        <name>Injection_Workbook_Logic</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        /* --- FINANCIAL CLASS must not be blank AND must not be the excluded values --- */
        NOT(ISBLANK({!$Record.AR_Financial_Class__c})),
        NOT(
            OR(
                {!$Record.AR_Financial_Class__c} = &quot;Auto Insurance&quot;,
                {!$Record.AR_Financial_Class__c} = &quot;Workers Compensation&quot;
            )
        ),

        /* --- PROCEDURE CODE must match --- */
        NOT(ISBLANK({!$Record.AR_Procedure_Code__c})),
        CONTAINS(
            &quot;62323,62321,64454,64624,64490,64491,64492,64493,64494,64495,64633,64634,64635,64636,64483,64484,27096,64555,64650&quot;,
            {!$Record.AR_Procedure_Code__c}
        ),

        /* --- PROVIDER ID must match --- */
        NOT(ISBLANK({!$Record.AR_Provider_Id__c})),
        CONTAINS(
            &quot;32515,32706,35227,35224,38948,40962&quot;,
            {!$Record.AR_Provider_Id__c}
        )
    ),
    &quot;Valid&quot;,
    &quot;Invalid&quot;
)</expression>
    </formulas>
    <formulas>
        <name>IR_A_to_J</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        NOT(ISBLANK({!$Record.AR_Patient_Account__r.dn_Name__c})),
        UPPER(TRIM({!$Record.AR_Patient_Account__r.dn_Name__c})) &gt;= &quot;A&quot;,
        UPPER(TRIM({!$Record.AR_Patient_Account__r.dn_Name__c})) &lt; &quot;K&quot;
    ),
    &quot;Valid&quot;,
    &quot;Invalid&quot;
)</expression>
    </formulas>
