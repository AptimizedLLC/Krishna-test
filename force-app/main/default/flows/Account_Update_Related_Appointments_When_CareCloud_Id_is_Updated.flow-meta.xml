<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Appointment_Count</name>
        <label>Assign Appointment Count</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <assignmentItems>
            <assignToReference>varAppointmentRecordCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Appointment_Records</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_If_Appointment_Records_Were_Found</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_If_Appointment_Records_Were_Found</name>
        <label>Check If Appointment Records Were Found</label>
        <locationX>176</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Appointment_Records_Were_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAppointmentRecordCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Patient_Lookups</targetReference>
            </connector>
            <label>Yes - Appointment Records Were Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Account: Update Related Appointments When CareCloud Id is Updated {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account: Update Related Appointments When CareCloud Id is Updated</label>
    <loops>
        <name>Update_Patient_Lookups</name>
        <label>Update Patient Lookups</label>
        <locationX>68</locationX>
        <locationY>647</locationY>
        <collectionReference>Get_Appointment_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Update_Patient_Lookup</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Appointment_Records</name>
        <label>Get Appointment Records</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Appointment_Count</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Care_Cloud_Patient_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CareCloud_Patient_Id__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Appointment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
