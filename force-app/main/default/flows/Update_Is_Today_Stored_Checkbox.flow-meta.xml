    <decisions>
        <name>Update_Is_Today</name>
        <label>Update Is Today</label>
        <locationX>314</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Today</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Appointment_Is_Today__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Appointment_Records</targetReference>
            </connector>
            <label>Is Today</label>
        </rules>
        <rules>
            <name>Is_Today_False</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Appointment_Date_Yesterday__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Is_Today__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_2_of_Update_Appointment_Records</targetReference>
            </connector>
            <label>Is Today False</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>calculates tomorrow’s date, ensuring that today&apos;s records are included but not future ones.</description>
        <name>Formula_TomorrowDate</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(TODAY()), MONTH(TODAY()), DAY(TODAY()) + 1)</expression>
    </formulas>
    <formulas>
        <name>Formula_YesterdayDate</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(TODAY()), MONTH(TODAY()), DAY(TODAY()) - 1)</expression>
    </formulas>
    <interviewLabel>Update Is Today Stored Checkbox {!$Flow.CurrentDateTime}</interviewLabel>
