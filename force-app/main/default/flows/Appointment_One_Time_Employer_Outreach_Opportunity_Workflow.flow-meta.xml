        <name>Check_Existing_Employer_Outreach_Opportunity_Status</name>
        <label>Check Existing Employer Outreach Opportunity Status</label>
        <locationX>512</locationX>
        <locationY>1008</locationY>
        <defaultConnector>
            <targetReference>Get_Employer_Outreach_Opportunity_Queue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>New_or_In_Progress</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Employer_Outreach_Opportunity.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Existing_Employer_Outreach_Opportunity.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Progress</stringValue>
                </rightValue>
            </conditions>
