        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Appointments_in_next_7_Days</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_Authorization_Records</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Authorization</targetReference>
        </noMoreValuesConnector>
