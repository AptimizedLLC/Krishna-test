        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Appointment__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_Appointment_Records.Id</elementReference>
            </value>
        </filters>
