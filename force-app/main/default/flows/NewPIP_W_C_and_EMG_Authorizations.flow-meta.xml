    <recordLookups>
        <name>Get_Appointments_in_next_7_Days</name>
        <label>Get Appointments in next 7 Days</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Appointment_Records</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 6 AND (3 OR 4 OR 5)</filterLogic>
        <filters>
            <field>Appointment_Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>fx_Next_7_Days</elementReference>
            </value>
        </filters>
        <filters>
            <field>Appointment_Date__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>Visit_Reason__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>MD - PIP</stringValue>
            </value>
        </filters>
        <filters>
            <field>Visit_Reason__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>MD - W/C</stringValue>
            </value>
        </filters>
        <filters>
            <field>Visit_Reason__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>MD - EMG CONSULT</stringValue>
            </value>
        </filters>
        <filters>
            <field>Auth_Created__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Appointment__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <queriedFields>Patient__c</queriedFields>
        <queriedFields>Location__c</queriedFields>
        <queriedFields>Visit_Reason__c</queriedFields>
        <queriedFields>Auth_Created__c</queriedFields>
        <sortField>Appointment_Date__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Authorization_Records</name>
        <label>Get Authorization Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
