        <object>Case</object>
        <outputAssignments>
            <assignToReference>varMostRecentVOBId</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
