        <locationX>248</locationX>
        <locationY>624</locationY>
        <defaultConnector>
            <targetReference>Get_Coverage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Fee_Schedule_No_OON</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varFeeScheduleFromInsurancePlan</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No OON</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_No_OON_to_Plan_Type</targetReference>
            </connector>
            <label>Yes - Fee Schedule No OON</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_There_a_VOB_Case</name>
        <label>Is There a VOB Case</label>
        <locationX>589</locationX>
        <locationY>408</locationY>
        <defaultConnector>
            <targetReference>Update_Appointment_for_Front_Desk</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_There_is_a_VOB_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varMostRecentVOBId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Insurance_Plan</targetReference>
            </connector>
            <label>Yes - There is a VOB Case</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fxDayOfTheWeek</name>
        <dataType>String</dataType>
        <expression>CASE(
   MOD( {!fxToday} - DATE(1985,6,24), 7),
   0, &quot;Monday&quot;,
   1, &quot;Tuesday&quot;,
   2, &quot;Wednesday&quot;,
   3, &quot;Thursday&quot;,
   4, &quot;Friday&quot;,
   5, &quot;Saturday&quot;,
   6, &quot;Sunday&quot;,
   &quot;Unknown&quot;
)</expression>
    </formulas>
    <formulas>
        <name>fxDayofWeekNumber</name>
        <dataType>Number</dataType>
        <expression>weekday(today())</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxToday</name>
        <dataType>Date</dataType>
        <expression>Today()</expression>
    </formulas>
    <formulas>
        <name>fxUnmetDeductible</name>
        <dataType>Currency</dataType>
        <expression>{!varOutOfNetworkDeductible} - {!varOutOfNetworkDeductibleMet}</expression>
        <scale>2</scale>
    </formulas>
