    <decisions>
        <name>Is_There_a_File</name>
        <label>Is There a File</label>
        <locationX>446</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>PPT_Not_Completed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PPT_Was_Not_Completed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account</targetReference>
            </connector>
            <label>PPT Not Completed</label>
        </rules>
        <rules>
            <name>No_There_Is_No_File_and_Unable_to_Complete_Unchecked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varContentDocumentCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>PPT_Was_Not_Completed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>No_File_and_No_Due_Date_Error</targetReference>
            </connector>
            <label>No There Is No File and Unable to Complete Unchecked</label>
        </rules>
        <rules>
            <name>Yes_There_Is_a_File</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varContentDocumentCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_PPT_Completed</targetReference>
            </connector>
            <label>Yes There Is a File</label>
        </rules>
    </decisions>
