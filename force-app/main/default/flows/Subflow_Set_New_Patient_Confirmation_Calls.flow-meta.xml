    <decisions>
        <name>Does_Visit_Reason_Contain_PIP</name>
        <label>Does Visit Reason Contain PIP?</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <defaultConnector>
            <targetReference>Get_Most_Recent_Major_Med_VOB</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Visit_Reason_Contain_PIP</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAppointment.Visit_Reason__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>PIP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Appointment</targetReference>
            </connector>
            <label>Yes - Visit Reason Contain PIP</label>
        </rules>
    </decisions>
    <decisions>
        <name>Front_Desk_or_Contact_Center_to_Make_Follow_Up_Call</name>
        <label>Front Desk or Contact Center to Make Follow Up Call?</label>
        <locationX>547</locationX>
        <locationY>1008</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Assign_No_OON_to_Plan_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Contact Center</defaultConnectorLabel>
        <rules>
            <name>Front_Desk</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>fxUnmetDeductible</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>1500.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Visit_Reason__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>PIP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOutOfNetworkDeductible</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fxUnmetFamilyDeductible</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>1500.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_for_Front_Desk</targetReference>
            </connector>
            <label>Front Desk</label>
        </rules>
    </decisions>
