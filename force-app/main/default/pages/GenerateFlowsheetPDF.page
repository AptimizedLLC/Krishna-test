<apex:page standardController="Account" extensions="VisitReasonController">
    <apex:form >
        <apex:pageBlock >
            <!-- Center-aligned title -->
            <div style="text-align: center; font-size: 25px; font-weight: bold; margin-bottom: 10px;">
                Select Visit Reason
            </div>

            <apex:pageBlockSection columns="1">
                <style>
                    .custom-radio label {
                        font-weight: bold;
                        font-size: 16px;
                        margin-bottom: 8px;
                        display: block;
                    }
                </style>

                <div class="custom-radio">
                    <apex:selectRadio value="{!selectedReasons}" layout="pageDirection">
                        <apex:selectOptions value="{!visitReasonOptions}" />
                    </apex:selectRadio>
                </div>
            </apex:pageBlockSection>

            <!-- Display error message if any -->
            <apex:pageMessages />

            <!-- Custom Generate PDF button -->
            <apex:pageBlockButtons location="bottom">
                <apex:commandButton value="Generate PDF" action="{!generatePDF}" />
            </apex:pageBlockButtons>
        </apex:pageBlock>
    </apex:form>
</apex:page>