<apex:page showHeader="false" sidebar="false" applyBodyTag="false" controller="SurgicalVerificationController" renderAs="pdf" >
     <head>
        <style>
            body {
               
                 font-size: 12pt;
                font-family: Arial Unicode MS ;
            }
            
          
        </style>
    </head>
     <body>
          <div width="100%" style="text-align: center;">
        <p>
            <img src="{!URLFOR($Resource.NJSpineImg)}" style="width: 525px;" />
        </p>
         </div>
            <apex:form >
                 <div>
                      <div id="patientDetails">
                       <table width="100%">
                        <tr>
                            <td style="width:80%; font-size: 11pt;">
                                <c:DynamicFormMember type="textWithUnderline" label="Pending Surgery Date:" width="65%" value="{!procedureDate}"/>
                            </td>
                           </tr>
                          </table>
                    <table width="100%">
                        <tr>
                            <td style="width:60%; font-size: 11pt;">
                                <c:DynamicFormMember type="textWithUnderline" label="**Patient Name" width="65%" value="{!insurancePlanRecord.Patient_Name__c}"/>
                            </td>
                            <td style="width:30% ; font-size: 11pt;">
                                <c:DynamicFormMember type="textWithUnderline" label="DOB:" width="80%" value="{!patientDOB}"/>
                            </td>
                          
                        </tr>
                    </table><br/>
                    <table width="100%"> 
                        <tr>
                            <td style="width:90% ; font-size: 11pt;">
                                    <c:DynamicFormMember type="textWithUnderline" label="**Surgeon Name:" width="67%" value="{!caseRecord.Surgical_Provider__c}"/> 
                                </td>
                           
                        </tr>
                    </table>
                            <table width="100%"> 
                        <tr>
                            <td style="width:90% ; font-size: 11pt;">
                                    <c:DynamicFormMember type="textWithUnderline" label="**In patient/ Out Patient" width="67%" value="{!caseRecord.Inpatient_Outpatient__c}"/> 
                                </td>
                           
                        </tr>
                    </table>
                           <table width="100%">
                        <tr>
                            <td style="width:60%; font-size: 11pt;">
                                <c:DynamicFormMember type="textWithUnderline" label="**Dx code" width="65%" value="{!caseRecord.DX_Codes_Text__c}"/>
                            </td>
                            <td style="width:30% ; font-size: 11pt;">
                                <c:DynamicFormMember type="textWithUnderline" label="**CPT Codes" width="60%" value="{!caseRecord.CPT_Codes_Text__c}"/>
                            </td>
                          
                        </tr>
                    </table>
                          <table width="100%">
                        <tr>
                            <td style="width:60%; font-size: 11pt;">
                                <c:DynamicFormMember type="textWithUnderline" label="Insurance:" width="65%" value="{!caseRecord.Primary_Insurance__c}"/>
                            </td>
                            <td style="width:30% ; font-size: 11pt;">
                                <c:DynamicFormMember type="textWithUnderline" label="ID #:" width="80%" value="{!caseRecord.Member_ID__c}"/>
                            </td>
                          
                        </tr>
                    </table>
                           <table width="100%">
                        <tr>
                            <td style="font-weight: bold; font-size: small;text-align: center; font-family: SansSerif !important;width:50%">
                                <u>IN NETWORK:</u>
                            </td>
                             <td style="font-weight: bold; font-size: small;text-align: center; font-family: SansSerif !important;width:50%">
                                <u>OUT OF NETWORK:</u>
                            </td>
                           
                        </tr>
                    </table>
               
                           <table width="100%">
                        <tr>
                            <td style="width:50%; font-size: 11pt;">
                               
                            </td>
                            <td style="width:40% ; font-size: 11pt;">
                                <c:DynamicFormMember type="textWithUnderline" label="Coinsurance:" width="60%" value="{!insurancePlanRecord.In_Network_Co_Insurance_Percentage__c}"/>
                            </td>
                          
                        </tr>
                    </table>
                           <table width="100%">
                        <tr>
                            <td style="width:20%">
                                <c:DynamicFormMember type="textWithUnderline" label="Ind Ded" width="50%" value="{!insurancePlanRecord.In_Network_Individual_Deductible__c}"/>
                            </td>
                           
                            <td style="width:20%">
                                <c:DynamicFormMember type="textWithUnderline" label="Met:" value="{!coverage.In_Network_Deductible_Met__c}" width="50%"/>
                            </td>
                             <td style="width:10%">
                                
                            </td>
                             <td style="width:20%">
                                <c:DynamicFormMember type="textWithUnderline" label="Ind Ded" value="{!insurancePlanRecord.Out_of_Network_Individual_Deductible__c}" width="50%"/>
                            </td>
                             <td style="width:20%">
                                <c:DynamicFormMember type="textWithUnderline" label="Met:" value="{!coverage.Out_of_Network_Deductible_Met__c}" width="50%"/>
                            </td>
                        </tr>
                    </table>
                 <table width="100%">
                        <tr>
                            <td style="width:20%">
                                <c:DynamicFormMember type="textWithUnderline" label="Ind OOP:" width="50%" value="{!insurancePlanRecord.In_Network_Out_of_Pocket_Max__c }"/>
                            </td>
                           
                            <td style="width:20%">
                                <c:DynamicFormMember type="textWithUnderline" label="Met:" value="{!coverage.In_Network_Out_of_Pocket_Max_Met__c}" width="50%"/>
                            </td>
                             <td style="width:10%">
                                
                            </td>
                             <td style="width:20%">
                                <c:DynamicFormMember type="textWithUnderline" label="Ind OOP:" value="{!insurancePlanRecord.Out_of_Network_Out_of_Pocket_Max__c}" width="50%"/>
                            </td>
                             <td style="width:20%">
                                <c:DynamicFormMember type="textWithUnderline" label="Met:" value="{!coverage.Out_of_Network_Out_of_Pocket_Max_Met__c}" width="50%"/>
                            </td>
                        </tr>
                    </table>
                           <table width="100%"> 
                        <tr>
                            <td style="width:90% ; font-size: 11pt;">
                                    <c:DynamicFormMember type="textWithUnderline" label="Auth Req/ Fax #" width="67%" value="{!insurancePlanRecord.How_to_Obtain_Procedure_Authorization__c}"/> 
                                </td>
                            </tr>
                    </table>
                         <!--  <table width="100%"> 
                        <tr>
                            <td style="width:90% ; font-size: 11pt;">
                                    <c:DynamicFormMember type="textWithUnderline" label="If auth is req’d can we initiate on an online platform? Y/N If so, what:" width="25%" value=""/> 
                                </td>
                            </tr>
                    </table> -->
                            <table width="100%"> 
                        <tr>
                            <td style="width:90% ; font-size: 11pt;">
                                    <c:DynamicFormMember type="textWithUnderline" label="Does this patient have Ambulatory Surgical Center benefits?" width="35%" value="{!insurancePlanRecord.Ambulatory_Surgery_Center_Covered__c }" />
                                </td>
                            </tr>
                    </table>
                      <table width="100%">
                        <tr>
                          
                            <td style="width:25%">
                                <c:DynamicFormMember type="textWithUnderline" label="Fee Schedule:" value="{!insurancePlanRecord.Fee_Schedule__c}"/>
                            </td> 
                            <td style="width:25%">
                                <c:DynamicFormMember type="textWithUnderline" label="Aggregate Allowance:" width="50px" value="{!insurancePlanRecord.Aggregate_Allowance__c }"/>
                            </td>
                            <td style="width: 25%">
                                <c:DynamicFormMember type="textWithUnderline" label="Allowance Percentage:" width="50px" value="{!insurancePlanRecord.Allowance_Percentage__c }"/>
                            </td>
                        </tr>
                    </table>
                      <table width="100%">
                        <tr>
                           
                            <td style="width:60% ; font-size: 11pt;">
                                <c:DynamicFormMember type="textWithUnderline" label="CallRef#" width="80%" value="{!insurancePlanRecord.Call_Reference_Number__c}"/>
                            </td>
                          
                        </tr>
                    </table>    
                          <table width="100%">
                        <tr>
                            <td style="width:60%; font-size: 11pt;">
                                <c:DynamicFormMember type="textWithUnderline" label="RepName " width="65%" value="{!insurancePlanRecord.Insurance_Company_Representative__c}"/>
                            </td>
                            <td style="width:30% ; font-size: 11pt;">
                                <c:DynamicFormMember type="textWithUnderline" label="Date/time" width="70%" value="{!todaydate}"/>
                            </td>
                          
                        </tr>
                    </table>  
                            <table width="100%">
                        <tr>
                            <td style="width:90%; font-size: 11pt;">
                                <c:DynamicFormMember type="textWithUnderline" label="Name: " width="65%" value="{!$User.FirstName}"/>
                            </td>
                             </tr>
                    </table>
                            <table width="100%">
                        <tr>
                            <td style="width:90%; font-size: 11pt; word-wrap: break-word;">
                                <c:DynamicFormMember type="textWithUnderline" label="Notes: " width="85%" value="{!insurancePlanRecord.Surgical_Verification_Notes__c}"/>
                            </td>
                             </tr>
                    </table>
                     </div>
                </div>
         </apex:form>
    </body>
</apex:page>