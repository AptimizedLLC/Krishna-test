<apex:page showHeader="false" sidebar="false" applyBodyTag="false" controller="InsurancePlanPDFController" renderAs="pdf">
    
    <head>
        <style>
            body {
                font-size: xx-small;
            }
            
            .borderedTable  {
                border: 0.6px solid black;
                border-collapse: collapse !important;
                border-spacing: 0px;
                vertical-align:top;
            }
            
            .borderedTableSingle  {
                border: 0.6px solid black;
                margin-top: -1px;
            }
            
            .borderedRight  {
                border-right: 0.6px solid black;
            }
            
            .borderTop  {
                border-top: 0.6px solid black;
            }
            
            .borderBottom  {
                border-bottom: 0.6px solid black;
            }
            
        </style>
    </head>
    
    <body>
        
        <apex:form >
