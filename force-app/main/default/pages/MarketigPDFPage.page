<apex:page standardController="Marketing_Campaign__c" renderAs="advanced_pdf">
  <head>
   
  </head>

  <body>
    
<div style="display: table; width: 100%;">
  <!-- Image cell -->
  <div style="display: table-cell; width: 220px; vertical-align: top;padding-top: 15px;">
    <img src="https://allianceortho.file.force.com/servlet/servlet.ImageServer?id=015UP000003pCyH&oid=00Df2000001HEGJ&lastMod=1715318986000" style="width: 300px;" />
  </div>

  <!-- Text content to the right -->
  <div style="display: table-cell; vertical-align: top; padding-left: 20px;">
      <h1 style="margin-bottom: 5px;">Marketing Event Recap </h1>
       <p style="margin-top: 0;"><strong>Submitted on  </strong> <apex:outputText value="{0,date,dd/MM/yy HH:mm:ss}">
        <apex:param value="{!Marketing_Campaign__c.CreatedDate}" />
    </apex:outputText></p>                
  </div>
</div>


