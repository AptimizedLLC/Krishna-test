<apex:page standardController="NPP__c" extensions="GenerateNPPIntakePDFDocumentController" renderAs="pdf" applyBodyTag="false">

    
<head>
    <style>
      .contentWrap h3 {
    padding: 20px;
    text-align: center;
    font-size: 25px;
    color: #f00;
}
.contentWrap {
    margin: 10px 30px;
}
span.bStrong {
    font-weight: 600;
    padding-right: 5px;
}
p {
    line-height: 22px;
}
img {
    border: 1px solid #000;
    margin-top: 10px;
}
    </style>
  </head>

    <head>
        <title></title>
        <style>
        .question {
            font-weight: bold;
        }
        .question2 {
    font-weight: bold;
    text-align: center;
    color: red;
}

        table,
            th,
            td {
            font-family: helvetica !important;
            font-size: 11pt !important;
            border: 0.6px solid black;
            border-collapse: collapse !important;
            border-spacing: 0px;
            vertical-align:top;
            
            }
            
            /* Solid border */
            hr.solid {
            border-top: 3px solid #bbb;
            }
            
            .subtitle {
            text-align: center;
            font-style: italic;
            font-weight: bold;
            }
            
            body {
            font-family: helvetica;
            }
            
            body td {
            font-family: helvetica;
            }
    </style>
    </head>
	
    <body> 
        
          <div>
            <p><img src="https://allianceortho.file.force.com/servlet/servlet.ImageServer?id=015UP000003pCyH&oid=00Df2000001HEGJ&lastMod=1715318986000"  style="width: 700px;"/></p>
    	  </div>

      <div class="contentWrap">
            <h3>
              Credit Card Authorization Form
            </h3>
         <div class="pdf-content consent-content18">
                  <div class="form-element">
                    <div class="question">Patient Name</div>
                    <div><apex:outputField value="{!NPP__c.HQ_Patient_Name__c}"/></div>
                  </div>
                  <div class="form-element">
                    <div class="question">Email</div>
                    <div><apex:outputField value="{!NPP__c.Account__r.PersonEmail}"/></div>
                  </div>
                  <div class="form-element">
                    <div class="question">Date of Birth</div>
                    <div><apex:outputField value="{!NPP__c.Account__r.Date_of_Birth__c}"/></div>
                  </div>
                  <div class="form-element">
                    <div>
                      <p>
                        I, <apex:outputField value="{!NPP__c.HQ_Patient_Name__c}"/>, hereby authorize the Practice to
                        charge the amount listed above to the credit card
                        provided herein. I agree to pay for these medical
                        services including but not limited to copay/coinsurance,
                        deductible and or insurance checks issued to the patient
                        intended for the provider in accordance with the issuing
                        bank cardholder agreement. If the above-noted charge
                        date falls on a weekend or holiday, I understand that
                        the payments may be executed on the next business day. I
                        certify that I am an authorized user of this credit card
                        and that I will not dispute the payment with my credit
                        card company provided the transaction corresponds to the
                        terms indicated in this authorization form.&nbsp;
                      </p>
                    </div>
                  </div>

                  <div class="form-element fiftyByFifty">
                    <div>
                      <div>
                        <label class="question">Card Holder Name</label>
                      </div>
<div>
    <apex:outputField value="{!NPP__c.HQ_Card_Holder_Name__c}"/>
                        </div>
                    </div>
                  </div>
                  <div class="form-element fiftyByFifty">
                    <div>
                      <div><label class="question">Billing Address</label></div>
<div><apex:outputField value="{!NPP__c.HQ_Billing_Address__c}"/>
    
                        </div>
                      
                  </div>
                  <div class="form-element">
                    <div class="dropdownStyle">
                      <div>
                        <label class="question">Credit Card Type</label>
                      </div>
<div><apex:outputField value="{!NPP__c.Account__r.HQ_Credit_Card_Type__c}"/>
    
                        </div>
                      
                    </div>
                  </div>
                  <div class="form-element">
                    <div>
                      <div>
                        <label class="question">Credit Card Number</label>
                      </div>
<div><apex:outputField value="{!NPP__c.Account__r.HQ_Credit_Card_Number__c}"/>
    
                        </div>
                      
                    </div>
                  </div>
                  <div class="form-element">
                    <div>
                      <div><label class="question">Expiry Date</label></div><apex:outputField value="{!NPP__c.Account__r.HQ_Expiration_Date__c}"/>
                      
                    </div>
                  </div>
                  <div class="form-element">
                    <div>
                      <div><label class="question">CVV</label></div><apex:outputField value="{!NPP__c.Account__r.HQ_Security_Code__c}"/>
                      
                    </div>
                  </div>
                </div>
            
            </div>
          </div>    
                  <div class="patientNameDate">
<div><label>Patient Name</label></div>
                      <div class="floatLeft"><apex:outputField value="{!NPP__c.HQ_Patient_Name__c}"/></div>
<div><label>Date</label></div>
                      <div class="floatRight"><apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!NPP__c.CreatedDate}" /></apex:outputText></div>
                    </div>
                 
                  <div class="form-element">
                    <div><p>Patient Signature</p></div>

                      <div>
                          <apex:outputText value="{!oppt.HQ_Signature__c}" escape="false" />
                          
                      </div>
                  </div>
              

        
        
          <div class="formCheck">
            <div>
              <img src='https://allianceortho.file.force.com/servlet/servlet.ImageServer?id=015UP000003gvo9&oid=00Df2000001HEGJ&lastMod=1714988677000' style="width: 15px; Height:15px"/>
                <label>By checking the box I acknowledge and agree to conduct business
                electronically, that I have read the terms of the above section,
                and that I agree to insert my electronic signature as set forth
                below indicating my consent to terms set forth on this page.
              </label>
            </div>
          </div>

  </body>

</apex:page>