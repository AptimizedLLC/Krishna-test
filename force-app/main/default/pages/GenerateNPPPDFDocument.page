            <tr><td class="question">Lower Leg Ulcers or Sores</td><td><apex:outputField value="{!NPP__c.HQ_History_of_Lower_Leg_Ulcers_or_Sores__c}"/></td></tr>
            <tr><td class="question">Cardiologist Presence</td><td><apex:outputField value="{!NPP__c.HQ_Cardiologist_Presence__c}"/></td></tr>
            <tr><td class="question">Lower Leg Hair Loss</td><td><apex:outputField value="{!NPP__c.HQ_Lower_Leg_Hair_Loss__c}"/></td></tr>
            <tr><td class="question">Lower Leg Numbness</td><td><apex:outputField value="{!NPP__c.HQ_Lower_Leg_Numbness_Tingling__c}"/></td></tr>
