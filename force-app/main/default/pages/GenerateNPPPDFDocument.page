            </apex:outputPanel>
        </td>
    </tr>
</table>

    <tr><td class="question">Relationship to Patient</td><td><apex:outputField value="{!NPP__c.HQ_Relationship_to_Patient__c}"/></td></tr>
</table>

       

        <!-- Blood Flow & Circulation Section -->
        <div class="section-title new-page">Blood Flow and Circulation Assessment</div>
        <table width="100%">
            <tr><td class="question">Varicose Veins</td><td><apex:outputField value="{!NPP__c.HQ_Vein_Conditions__c}"/></td></tr>
            <tr><td class="question">Leg Swelling/Fatigue</td><td><apex:outputField value="{!NPP__c.HQ_legs_feel_heavy_tired_achy_or__c}"/></td></tr>
            <tr><td class="question">Legs feel better with rest</td><td><apex:outputField value="{!NPP__c.HQ_legs_feel_better_with_rest__c}"/></td></tr>
            <tr><td class="question">End of Day legs Swelling</td><td><apex:outputField value="{!NPP__c.HQ_legs_swell_at_the_end_of_the_day__c}"/></td></tr>
            <tr><td class="question">Morning vs Evening Leg Comfort</td><td><apex:outputField value="{!NPP__c.HQ_Morning_vs_Evening_Leg_Comfort__c}"/></td></tr>
