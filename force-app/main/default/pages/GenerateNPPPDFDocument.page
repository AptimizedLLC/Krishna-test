            </apex:outputPanel>
        </td>
    </tr>
    <tr>
        <td>Heart Murmur/Arrhythmia</td>
        <td><apex:outputField value="{!NPP__c.HQ_Heart_Arrhythmia_Murmur__c}"/></td>
        <td><apex:outputPanel rendered="{!NPP__c.HQ_Heart_Arrhythmia_Murmur__c == 'Yes'}">
                <apex:outputField value="{!NPP__c.HQ_Date_Diagnosed_Heart_Arrhythmia__c}"/>
            </apex:outputPanel>
        </td>
    </tr>
    <tr>
        <td>Active Cancer</td>
        <td><apex:outputField value="{!NPP__c.HQ_Active_Cancer_Diagnosis__c}"/></td>
        <td><apex:outputPanel rendered="{!NPP__c.HQ_Active_Cancer_Diagnosis__c == 'Yes'}">
                <apex:outputField value="{!NPP__c.HQ_Date_Diagnosed_Active_Cancer_Diagnosi__c}"/>
