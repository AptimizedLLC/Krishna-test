        <td><apex:outputField value="{!NPP__c.HQ_Do_you_have_a_history_of_myocarditis__c}"/></td>
        <td><apex:outputPanel rendered="{!NPP__c.HQ_Do_you_have_a_history_of_myocarditis__c == 'Yes'}">
                <apex:outputField value="{!NPP__c.HQ_Date_Diagnosed_Myocarditis__c}"/>
            </apex:outputPanel>
        </td>
    </tr>
    <tr>
        <td>Heart Attack</td>
        <td><apex:outputField value="{!NPP__c.HQ_Ever_had_Heart_Attacks__c}"/></td>
        <td><apex:outputPanel rendered="{!NPP__c.HQ_Ever_had_Heart_Attacks__c == 'Yes'}">
                <apex:outputField value="{!NPP__c.HQ_Date_Diagnosed_Heart_Attacks__c}"/>
